{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foxxx009/watershed-mcp/sensor_schema.json",
  "title": "Ecological Sensor Reading (watershed subset)",
  "description": "Standard sensor-reading shape from the Ecological Sensor Data JSON Schema Standard (owockibot bounty #450, https://github.com/xtratrezzy/ecological-sensor-schema), restricted to the water-quality fields emitted by watershed-mcp. Every reading from this server validates against this schema.",
  "type": "object",
  "required": ["timestamp", "location", "unit", "value", "sensor_id", "source"],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 instant (USGS) or activity date (WQP, YYYY-MM-DD)"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lng": {"type": ["number", "null"], "minimum": -180, "maximum": 180}
      }
    },
    "unit": {"type": "string", "examples": ["ft3/s", "mg/L", "deg C", "std units", "FNU"]},
    "value": {"type": "number"},
    "sensor_id": {"type": "string", "description": "USGS-<8digit> or WQX monitoring-location identifier"},
    "source": {"type": "string"},
    "parameter": {"type": "string"},
    "parameter_code": {"type": ["string", "null"], "description": "USGS 5-digit parameter code when applicable"},
    "usgs_pcode": {"type": ["string", "null"], "description": "USGS parameter code as reported by WQP"},
    "label": {"type": ["string", "null"], "description": "human-readable parameter label (USGS live series)"},
    "site_name": {"type": ["string", "null"]},
    "qualifier": {"type": ["string", "null"]},
    "sample_fraction": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]}
  }
}
